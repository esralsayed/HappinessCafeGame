  levels:
  - sceneName: Day 1
    title: Day 1 - Espresso
    recap: You have just arrived at Grandma's cafe. Today she will teach you the basics, one espresso at a time.
    factRecipe: {fileID: 11400000, guid: de7e0bfb9061a864f81f29027e1d8750, type: 2}
    requiredFlag: 
    completeFlag: level1Complete
  - sceneName: Day 2
    title: Day 2 - Milk
    recap: The first torn page is restored. Today you learn to steam milk, and Grandma has a lot to say about temperature.
    factRecipe: {fileID: 11400000, guid: 6ad69dc6c791c174c8e45e77a3ca7085, type: 2}
    requiredFlag: level1Complete
    completeFlag: level2Complete
  - sceneName: Day 3
    title: Day 3 - The Special Order
    recap: Mrs. Lulu is coming today, and she is hard to please. Grandma's signature drink is waiting for you.
    factRecipe: {fileID: 11400000, guid: babf945e599aa47489fe28c9c82955da, type: 2}
    requiredFlag: level2Complete
    completeFlag: level3Complete
  mainMenuScene: MainMenu
  minSeconds: 2.5
